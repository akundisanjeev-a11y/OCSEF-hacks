      "InsufficientForecast": {
        "properties": {
          "data_mode": {
            "type": "string",
            "const": "historical_demo",
            "title": "Data Mode",
            "default": "historical_demo"
          },
          "observation_cutoff": {
            "type": "string",
            "format": "date",
            "title": "Observation Cutoff"
          },
          "simulated_issue_date": {
            "type": "string",
            "format": "date",
            "title": "Simulated Issue Date"
