          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mmsi",
          "timestamp",
          "position"
        ],
        "title": "AISPoint"
