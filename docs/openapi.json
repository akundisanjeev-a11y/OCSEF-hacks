{
  "openapi": "3.1.0",
  "info": {
    "title": "GhostFleet Activity Forecast & Detection",
    "description": "Historical worldwide apparent-fishing activity forecasts. Earlier detection/AIS routes remain available. Forecasts do not determine authorization.",
    "version": "0.2.0"
  },
  "paths": {
    "/api/activity-forecast/info": {
      "get": {
        "tags": [
          "Activity forecast"
        ],
        "summary": "Forecast Info",
        "operationId": "forecast_info_api_activity_forecast_info_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/activity-forecast": {
      "post": {
        "tags": [
          "Activity forecast"
        ],
        "summary": "Forecast",
        "operationId": "forecast_api_activity_forecast_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForecastRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ScoredForecast"
                    },
                    {
                      "$ref": "#/components/schemas/InsufficientForecast"
                    }
                  ],
                  "title": "Response Forecast Api Activity Forecast Post",
                  "discriminator": {
                    "propertyName": "status",
                    "mapping": {
                      "scored": "#/components/schemas/ScoredForecast",
                      "insufficient_data": "#/components/schemas/InsufficientForecast"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Status"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/detections": {
      "post": {
        "tags": [
          "Detection"
        ],
        "summary": "Detect",
        "operationId": "detect_detections_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_detect_detections_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetectionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/matches": {
      "post": {
        "tags": [
          "AIS matching"
        ],
        "summary": "Matches",
        "operationId": "matches_matches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/demo/matches": {
      "get": {
        "tags": [
          "Fictional examples"
        ],
        "summary": "Demo Matches",
        "operationId": "demo_matches_demo_matches_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AISCoverage": {
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "title": "Source"
