          "mmsi": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9]{9}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mmsi"
          },
          "imo": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Imo"
          },
          "match_evidence": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MatchEvidence"
              },
              {
                "type": "null"
              }
            ]
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation_id",
          "scene_id",
          "data_mode"
