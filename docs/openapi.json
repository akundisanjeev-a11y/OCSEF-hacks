        "required": [
          "observation_cutoff",
          "simulated_issue_date",
          "target_start",
          "target_end",
          "model_version",
          "model_sha256",
          "selected_method",
          "source_dataset",
          "grid_degrees",
          "availability_lag_days"
        ],
        "title": "ForecastInfo"
      },
      "ForecastRequest": {
        "properties": {
