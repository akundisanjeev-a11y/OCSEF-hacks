            "type": "string",
            "format": "date",
            "title": "Simulated Issue Date"
          },
          "target_start": {
            "type": "string",
            "format": "date",
            "title": "Target Start"
          },
          "target_end": {
            "type": "string",
            "format": "date",
            "title": "Target End"
          },
          "status": {
            "type": "string",
            "const": "ready",
            "title": "Status",
            "default": "ready"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "model_sha256": {
            "type": "string",
            "title": "Model Sha256"
          },
          "selected_method": {
            "type": "string",
            "title": "Selected Method"
          },
          "source_dataset": {
            "type": "string",
            "title": "Source Dataset"
          },
          "grid_degrees": {
            "type": "integer",
            "title": "Grid Degrees"
          },
          "minimum_history_days": {
            "type": "integer",
            "title": "Minimum History Days",
            "default": 28
          },
          "availability_lag_days": {
            "type": "integer",
            "title": "Availability Lag Days"
          },
          "evaluation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvaluationSummary"
              },
