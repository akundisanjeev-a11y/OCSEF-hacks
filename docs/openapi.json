          },
          "image_height": {
            "type": "integer",
            "title": "Image Height"
          },
          "observations": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Observations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
