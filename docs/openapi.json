            "contentMediaType": "application/octet-stream",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_detect_detections_post"
      },
      "Bounds-Input": {
        "properties": {
          "south": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "South"
          },
          "north": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "North"
          },
          "west": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "West"
          },
          "east": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "East"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "south",
          "north",
          "west",
          "east"
        ],
        "title": "Bounds"
      },
      "Bounds-Output": {
        "properties": {
          "south": {
            "type": "number",
            "title": "South"
          },
          "north": {
            "type": "number",
            "title": "North"
          },
          "west": {
            "type": "number",
            "title": "West"
          },
          "east": {
            "type": "number",
            "title": "East"
          }
        },
        "type": "object",
        "required": [
          "south",
          "north",
          "west",
          "east"
        ],
        "title": "Bounds"
      },
      "Candidate": {
        "properties": {
          "mmsi": {
            "type": "string",
            "pattern": "^[0-9]{9}$",
            "title": "Mmsi"
          },
          "estimated_position": {
            "$ref": "#/components/schemas/Position"
          },
