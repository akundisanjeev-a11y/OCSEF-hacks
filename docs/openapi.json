            "title": "Supporting Timestamps"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "mmsi",
          "estimated_position",
          "distance_m",
          "max_supporting_time_gap_s",
          "supporting_timestamps"
        ],
        "title": "Candidate"
      },
      "DecisionStep": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "observed": {
            "type": "number",
            "title": "Observed"
          },
          "comparison": {
            "type": "string",
            "enum": [
              "<=",
              ">"
            ],
            "title": "Comparison"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          }
        },
        "type": "object",
