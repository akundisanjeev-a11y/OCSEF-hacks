              "model_upload",
              "synthetic",
              "published_historical"
            ],
            "title": "Data Mode"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "bounds": {
            "$ref": "#/components/schemas/Bounds-Input"
          },
          "adequate_for_search": {
            "type": "boolean",
            "title": "Adequate For Search",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "data_mode",
          "start",
          "end",
          "bounds"
        ],
        "title": "AISCoverage"
      },
      "AISPoint": {
        "properties": {
          "mmsi": {
            "type": "string",
            "pattern": "^[0-9]{9}$",
