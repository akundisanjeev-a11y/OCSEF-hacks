# Copy to .env if you want to change these defaults.
# GFW token stays on the backend; never commit a populated .env.
GFW_TOKEN=
# Earlier image-detection experiment; the activity forecast does not need it.
ENABLE_SHIP_DETECTOR=false
MODEL_PATH=weights/best.pt
# Saved activity-forecast checkpoint and prepared local data (separate from YOLO).
ACTIVITY_FORECAST_MODEL_PATH=weights/activity_forecast/best_model.joblib
ACTIVITY_FORECAST_DATA_DIR=datasets/activity_forecast/processed
DETECTION_CONFIDENCE=0.25
INFERENCE_DEVICE=cpu
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Illustrative matching gates; not validated operational thresholds.
MAX_AIS_POINT_GAP_SECONDS=300
MAX_MATCH_DISTANCE_METERS=500
