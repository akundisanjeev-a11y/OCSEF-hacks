# Copy to .env; never commit populated credentials.
GFW_API_TOKEN=
ACTIVITY_FORECAST_MODEL_PATH=weights/activity_forecast/best_model.joblib
# Leave blank to restore the matching bundled release automatically. Set only for custom history.
ACTIVITY_FORECAST_DATA_DIR=
# Optional local coral/seagrass reference index; date-excluded from scoring.
PRIORITY_HABITAT_INDEX=datasets/priority_engine/habitats/habitats.sqlite
